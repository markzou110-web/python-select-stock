# Alpha Vision Pro - 环境变量配置示例
# 复制此文件为 .env 并填入你的API密钥

# ==========================================
# 智谱AI配置（推荐，用于情绪分析）
# ==========================================
# 获取方式：访问 https://open.bigmodel.cn/ 注册并创建API Key
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# ==========================================
# DeepSeek配置（备选）
# ==========================================
# 如果没有设置智谱AI，系统会自动使用DeepSeek
# 获取方式：访问 https://platform.deepseek.com/ 注册并创建API Key
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ==========================================
# Bark推送通知配置
# ==========================================
# 获取方式：iPhone下载Bark App，获取推送密钥
BARK_KEY=your_bark_key_here

# ==========================================
# 数据库配置（可选，默认使用SQLite）
# ==========================================
# 如果使用PostgreSQL，请取消注释并填写：
# DATABASE_URL=postgresql://username:password@localhost:5432/alpha_vision

# ==========================================
# API配置
# ==========================================
# 后端监听地址
HOST=127.0.0.1
PORT=8000

# ==========================================
# 系统配置
# ==========================================
# 数据同步并发数（默认10）
MAX_SYNC_WORKERS=10

# 最小市值过滤（单位：亿，默认50）
MIN_MARKET_CAP=50
