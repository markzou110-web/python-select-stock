# Alpha Vision Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Bark Push Notification
# Get your key from https://github.com/Finb/Bark
BARK_KEY=your_bark_key_here

# Optional AI review for strategy-selected candidates (OpenAI-compatible API)
AI_ANALYSIS_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_MAX_CANDIDATES=10

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=stock_db

# Alternative: Use full database URL (overrides individual DB settings)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# API Security
# Generate a secure token: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
ENABLE_AUTH=false
# Keep 127.0.0.1 for local-only access; change explicitly only when LAN access is required.
API_HOST=127.0.0.1

# CORS Settings
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCAN=10/minute
RATE_LIMIT_SYNC=1/hour
# Shared by batch and single-stock AI requests; limits accidental API spend.
RATE_LIMIT_AI=30/day

# Sentinel Settings
SENTINEL_DEFAULT_TIME=14:20

# Scanning Defaults
DEFAULT_THRESHOLD=0.12
DEFAULT_VOL_MULTIPLIER=1.5
DEFAULT_RSI_MIN=55
DEFAULT_TURNOVER_MIN=3.0

# API Configuration
AKSHARE_TIMEOUT=30
MAX_WORKERS=15
TUSHARE_TOKEN=your_tushare_token_here


# Environment
ENVIRONMENT=development
DEBUG=true
